{
  "name": "agent-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "6.28.1"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @agent-town/web && npm run build -w @agent-town/service",
    "start": "node apps/service/dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/test-browser.mjs",
    "doctor": "node scripts/doctor.mjs",
    "safety-copy": "node scripts/safety-copy.mjs",
    "ops": "node apps/service/dist/ops.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vitest": "^4.1.0"
  }
}
